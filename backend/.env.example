APP_ENV=development
PORT=8080

# PostgreSQL connection string.
DATABASE_URL=postgres://shield:shield@localhost:5432/shield?sslmode=disable

# Comma-separated list of origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# S3-compatible object storage (Railway bucket, or MinIO locally).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OpenAI API key. Backend-only — never exposed to the frontend.
OPENAI_API_KEY=

# Used to sign session cookies. Generate a long random value for real deployments.
SESSION_SECRET=change-me-in-production
