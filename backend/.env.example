APP_ENV=development
PORT=8080

# PostgreSQL connection string.
DATABASE_URL=postgres://shield:shield@localhost:5432/shield?sslmode=disable

# Comma-separated list of origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# S3-compatible object storage (Railway bucket, or MinIO locally).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OpenAI API key. Backend-only — never exposed to the frontend.
OPENAI_API_KEY=

# When "true", image evidence is sent directly to OpenAI alongside its
# OCR'd text (Tesseract struggles with natural photos, e.g. a sign in a
# crowd scene). This is a real privacy-boundary change — the image's
# actual pixels leave the system for a third party — so it's off unless
# explicitly enabled, independent of whether OPENAI_API_KEY is set.
AI_VISION_ENABLED=false

# Self-hosted content-safety (NudeNet) service. Leave unset to disable
# classification — uploaded images then stay "quarantined" instead of being
# marked safe with nothing actually checked.
NUDENET_SERVICE_URL=http://localhost:8000

# Self-hosted in-place PDF redaction service. Leave unset to fall back to a
# redacted plain-text transcript instead of an actual redacted PDF.
PDF_REDACT_SERVICE_URL=http://localhost:8001

# Used to sign session cookies. Generate a long random value for real deployments.
SESSION_SECRET=change-me-in-production
